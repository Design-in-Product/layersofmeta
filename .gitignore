# Comprehensive .gitignore for API Security

# ============================================
# SECURITY - NEVER COMMIT THESE
# ============================================
# Environment variables and secrets
.env
.env.local
.env.development
.env.test
.env.production
.env.staging
*.env

# API keys and credentials
*api_key*
*secret*
*token*
*password*
credentials.json
secrets.json
config.json
settings.json

# SSH keys
*.pem
*.key
id_rsa*
id_ed25519*

# ============================================
# PYTHON
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt


# Virtual environments
venv/
env/
ENV/
env.bak/
venv.bak/
.venv/
env.local
venv_new/
saint_lucifer_env/
hades/

# Jupyter Notebook
.ipynb_checkpoints

# PyCharm
.idea/

# ============================================
# NODE.JS
# ============================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.npm
.eslintcache
.yarn-integrity

# ============================================
# MACOS
# ============================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db


# ============================================
# MEDIA/CONTENT FILES (Large files)
# ============================================
# Video files
*.mp4
*.avi
*.mov
*.mkv
*.wmv
*.flv

# Audio files
*.mp3
*.wav
*.flac
*.aac

# Image sequences/bulk images
frames/
keyframes/
keyframe_versions/
processed/
rendered/
output/
exports/
temp_images/
image_sequence/

# Large data files
*.zip
*.tar.gz
*.rar
*.7z

# ============================================
# PROJECT-SPECIFIC ADDITIONS
# ============================================
# Accidental pip-install artifacts (from `pip install >=x.y.z` redirecting to a file)
=*

# SSH keypairs that were committed by mistake (purged from history 2026-07)
runpod
runpod.pub
*.pub

# RunPod / infra credentials
runpod/

# Archived RIFE frame-interpolation experiments (older attempt, kept locally for
# reference but not tracked — includes 32MB model weights in train_log/)
RIFE/
ECCV2022-RIFE/
oldRIFE/
train_log/

# Local media archive (4.8GB: audio masters, keyframes, nested venvs, and a
# 2025 project snapshot). Kept on disk only — contains files over GitHub's
# 100MB limit. Recovered backend code from here was committed 2026-07.
videos/

# ============================================
# IDE AND EDITOR FILES
# ============================================
.vscode/settings.json
.vscode/launch.json
.vscode/extensions.json
*.swp
*.swo
*~

# ============================================
# LOGS AND DATABASES
# ============================================
*.log
*.sqlite
*.db











.env
dotenv.txt
*.env
.env
*.env
